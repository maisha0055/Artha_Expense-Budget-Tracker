# MySQL Configuration
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=financetracker
MYSQL_USER=financetracker
MYSQL_PASSWORD=financetracker_secret
MYSQL_PORT=3306

# Backend Connection String
ConnectionStrings__DefaultConnection="Server=localhost;Port=3306;Database=financetracker;User=root;Password=root_password;"

# JWT Settings
Jwt__Secret="SuperSecretKeyForJwtAuthenticationMustBeAtLeast32BytesLong!"
Jwt__Issuer="FinanceTrackerApi"
Jwt__Audience="FinanceTrackerClient"
Jwt__ExpiryMinutes=60
